{
  "manifest_version": 3,
  "name": "Walled Guard - DLP for ChatGPT & Perplexity",
  "version": "1.0.0",
  "description": "Lightweight Data Loss Prevention guard for ChatGPT and Perplexity. Intercepts sensitive prompts and file uploads in real browsers.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Walled Guard DLP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://www.perplexity.ai/*",
    "https://*.perplexity.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://www.perplexity.ai/*",
        "https://*.perplexity.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
