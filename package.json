{
  "name": "walled-guard",
  "version": "1.0.0",
  "description": "Lightweight DLP desktop guard for ChatGPT and Perplexity",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron out/main/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win --dir",
    "dist:installer": "electron-vite build && electron-builder --win",
    "seed": "tsx scripts/seed-demo-data.ts"
  },
  "keywords": [
    "dlp",
    "electron",
    "chatgpt",
    "perplexity",
    "security"
  ],
  "build": {
    "appId": "com.walledguard.app",
    "productName": "Walled Guard",
    "win": {
      "icon": "resources/icon.ico"
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "zod": "^3.24.0"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "jimp": "^1.6.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0"
  }
}
